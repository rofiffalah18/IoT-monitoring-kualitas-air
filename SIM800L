#include <HardwareSerial.h>

// --- PIN SERIAL SIM800L ---
#define SIM800_RX_PIN 17  // ESP32 RX1 -> Dihubungkan ke TX SIM800L
#define SIM800_TX_PIN 4   // ESP32 TX1 -> Dihubungkan ke RX SIM800L

HardwareSerial simSerial(1);

// Fungsi pembantu untuk mengirim AT Command dan membaca responnya
String sendAT(String command, const int timeout = 2000) {
  String response = "";
  simSerial.println(command);
  long int time = millis();
  while ((time + timeout) > millis()) {
    while (simSerial.available()) {
      char c = simSerial.read();
      response += c;
    }
  }
  return response;
}

void setup() {
  Serial.begin(115200);
  
  // Inisialisasi Serial SIM800L di Baudrate 9600
  simSerial.begin(9600, SERIAL_8N1, SIM800_RX_PIN, SIM800_TX_PIN);

  Serial.println("\n==========================================");
  Serial.println("   DIAGNOSTIK KONEKSI SIM800L + ESP32    ");
  Serial.println("==========================================");
  Serial.println("Menunggu modul siap (booting)...");
  delay(3000); // Tunggu 3 detik

  // 1. Tes Komunikasi Dasar
  Serial.print("\n1. Cek Komunikasi Serial (AT)... ");
  String resAT = sendAT("AT");
  if (resAT.indexOf("OK") != -1) {
    Serial.println("✅ OK (ESP32 & SIM800L Terhubung)");
  } else {
    Serial.println("❌ FAILED! Cek kabel TX/RX, Baudrate, dan Power 4.0V!");
  }

  // 2. Cek Kartu SIM
  Serial.print("2. Cek Kartu SIM (AT+CPIN?)... ");
  String resSIM = sendAT("AT+CPIN?");
  if (resSIM.indexOf("READY") != -1) {
    Serial.println("✅ Terbaca (READY)");
  } else {
    Serial.println("❌ Kartu SIM Tidak Terdeteksi / Ada PIN Lock!");
  }

  // 3. Cek Sinyal GSM
  Serial.print("3. Cek Kekuatan Sinyal (AT+CSQ)... ");
  String resCSQ = sendAT("AT+CSQ");
  Serial.print(resCSQ);
  // Catatan: Nilai CSQ 10-31 = Bagus, 0-9 = Sinyal Lemah, 99 = Tidak ada sinyal

  // 4. Cek Registrasi Jaringan GSM
  Serial.print("4. Cek Registrasi Jaringan (AT+CREG?)... ");
  String resCREG = sendAT("AT+CREG?");
  if (resCREG.indexOf(",1") != -1 || resCREG.indexOf(",5") != -1) {
    Serial.println("✅ Terregistrasi ke Jaringan Operator");
  } else {
    Serial.println("❌ Belum Terhubung ke Jaringan! (Cek LED SIM800L)");
  }

  // 5. Cek Nama Provider/Operator
  Serial.print("5. Cek Provider Operator (AT+COPS?)... ");
  String resCOPS = sendAT("AT+COPS?");
  Serial.println(resCOPS);

  Serial.println("\n==========================================");
  Serial.println("Mode Serial Passthrough Aktif.");
  Serial.println("Anda bisa ketik perintah AT manual di Serial Monitor!");
  Serial.println("==========================================");
}

void loop() {
  // Mode Passthrough: Apa yang Anda ketik di Serial Monitor dikirim ke SIM800L
  if (Serial.available()) {
    simSerial.write(Serial.read());
  }
  // Apa yang dibalas SIM800L ditampilkan di Serial Monitor
  if (simSerial.available()) {
    Serial.write(simSerial.read());
  }
}
